{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update upstream application versions in Helm charts",
      "managerFilePatterns": [
        "charts/**/Chart.yaml"
      ],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[^\\s]+) depName=(?<depName>[^\\s]+)\\s+appVersion:\\s*[\"']?(?<currentValue>[^\"'\\s]+)[\"']?"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Bump Helm chart patch version when appVersion changes",
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["apps/**/Chart.yaml"],
      "bumpVersions": [
        {
          "name": "Bump Helm chart version",
          "filePatterns": ["{{packageFileDir}}/Chart.yaml"],
          "matchStrings": [
            "version:\\s*[\"']?(?<version>[^\"'\\s]+)[\"']?"
          ],
          "bumpType": "patch"
        }
      ]
    }
  ]
}
